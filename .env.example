# NEVER commit real secrets. Copy to .env and fill locally.
# Supabase
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# API
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Auth (Supabase Auth is primary; this JWT secret is only for local API tokens if needed)
JWT_SECRET=change-me-in-dev-only

# LLM (provider-agnostic — set active provider + key)
# Gemini OpenAI-compat example (fast):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_TOKENS=300
LLM_TIMEOUT_MS=15000

# API body limit (bytes) — document uploads (pdf/docx base64) need headroom
BODY_LIMIT=50331648

# Embeddings (needs same provider for ALL chunks in a workspace; after switching,
# re-run: DATABASE_URL=... EMBEDDING_API_KEY=... node scripts/_reembed.cjs)
# Gemini example (fast, free tier — request exact storage dims):
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EMBEDDING_MODEL=gemini-embedding-001
# unset key -> local fastembed bge-small (no key, slower on CPU: ~3s/query)
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=

# STT (voice runtime — keyless local faster-whisper by default; to upgrade to
# hosted whisper / deepgram: set STT_API_KEY or DEEPGRAM_API_KEY)
STT_PROVIDER=whisper-compatible
STT_API_KEY=
DEEPGRAM_API_KEY=
STT_MODEL=base.en
STT_BASE_URL=
STT_LANGUAGE=auto
# Accuracy vs speed: beam 1 is fastest (<120ms), 5 is for slow batch dictation (default 1)
STT_BEAM_SIZE=1
# Turn detection endpoint silence (ms) - 320ms for instant sub-430ms turn-taking
VAD_ENDPOINT_SILENCE_MS=320
# Pre-speech audio buffer (ms) - preserves leading consonants/syllables so STT never cuts words off
VAD_PREFIX_MS=240
# Diarization: disabled (0) for calls to eliminate ~600ms latency hit
STT_DIARIZE=0
# Streaming transcripts: how much speech before a speculative draft (~900ms)
STT_CHUNK_MS=900
# How long the endpoint waits for the in-flight draft before answering anyway
DRAFT_JOIN_TIMEOUT_S=0.2

# TTS (voice runtime — keyless local piper by default; to upgrade to hosted
# OpenAI-compatible /audio/speech: set TTS_API_KEY (+ model/voice below)
# TTS: default = Microsoft Edge neural voices (keyless, natural American tone);
# TTS_PROVIDER=piper forces local piper; set TTS_API_KEY for hosted OpenAI-style TTS
TTS_PROVIDER=
EDGE_TTS_VOICE=en-US-AvaNeural
EDGE_TTS_RATE=-5%
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_BASE_URL=
TTS_VOICE=alloy
# Local piper fallback: cap onnxruntime threads (thread thrash = 10x slower)
TTS_ONNX_THREADS=2

# Web search
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=

# Voice runtime (Pipecat service)
VOICE_PORT=7860
VOICE_TRANSPORT=webrtc
VOICE_ALLOW_BARGE_IN=true
VOICE_MAX_CONVERSATION_TURNS=50
VOICE_AUDIO_SAMPLE_RATE=16000
# Auto greeting spoken right after "ready" (set to 'off' to disable)
VOICE_GREETING=Hi, thanks for calling! Go ahead whenever you're ready.

# API auth membership cache (ms) — cuts Supabase roundtrips on every message
AUTH_CACHE_MS=60000

# RAG / Context
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
RAG_RERANK_TOP_K=3
CONTEXT_MAX_TOKENS=6000

# Memory retention (days, 0 = session only)
MEMORY_SHORT_TERM_TURNS=20
MEMORY_LONG_TERM_DAYS=180

# Frontend
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://xyz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
